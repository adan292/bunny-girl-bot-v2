# Prefijo de comandos
PREFIX=.

# Número del dueño del bot (sin +, sin espacios). Es quien puede usar
# .setname, .serbot, .delbot, etc.
OWNER=9779829141452

# Nombre por defecto que llevará cualquier bot (main o subbot) hasta que se edite con .setname
DEFAULT_BOT_NAME=Megumi

# Ruta del archivo sqlite (se comparte entre el main y todos los subbots)
DB_PATH=./data/bot.db

# Método de login: "qr" o "code"
LOGIN_METHOD=code

# El número del bot PRINCIPAL no va aquí: la primera vez que corras el bot
# (npm run dev / npm start) la consola te lo va a preguntar directamente y
# ahí se guarda en la base de datos. En los siguientes arranques ya no
# vuelve a preguntar, se reconecta solo con lo que ya está guardado.
