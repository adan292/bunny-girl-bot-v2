# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
PRETTY_LOGS=true

# Pairing Code authentication. Use E.164 digits with country code.
# Examples: +52 771 000 0000 or +58 412 000 0000
# Do not commit a real phone number to the repository.
PAIRING_PHONE=
OWNER_JIDS=
COMMAND_PREFIXES=./!
AUTH_DIR=./data/auth
SESSION_ID=primary

# Dynamic plugin pipeline
PLUGINS_DIR=./src/plugins
PLUGIN_WATCH=true

# Inbound safety limits
MAX_TEXT_LENGTH=4096
MAX_INBOUND_BATCH=50
MAX_PLUGIN_QUEUE=100
MAX_PLUGIN_CONCURRENCY=8
PERMISSION_TIMEOUT_MS=5000
GROUP_METADATA_TTL_MS=30000
ANTILINK_REMOVE_USER=false

# Outbound safety limits. These are compliance safeguards, not ban evasion.
OUTBOUND_GLOBAL_PER_SECOND=5
OUTBOUND_PER_CHAT_PER_SECOND=0.5
OUTBOUND_QUEUE_LIMIT=200

# Reconnect policy
RECONNECT_BASE_MS=1000
RECONNECT_MAX_MS=60000
RECONNECT_JITTER_RATIO=0.25

# Media limits and subprocess protection
FFMPEG_TIMEOUT_MS=30000
MAX_STICKER_BYTES=1048576
FFMPEG_PATH=
DOWNLOAD_MAX_BYTES=8388608
DOWNLOAD_TIMEOUT_MS=20000
ECONOMY_DIR=./data/economy
